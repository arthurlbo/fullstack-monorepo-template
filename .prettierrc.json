{
    "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
    "bracketSameLine": false,
    "bracketSpacing": true,
    "jsxSingleQuote": false,
    "printWidth": 120,
    "tabWidth": 4,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrder": [
        "^\\./.*\\.css$",
        "^node(:.*)?$",
        "^@nestjs(/.*)?$",
        "^react$",
        "^next(/.*)?$",
        "<THIRD_PARTY_MODULES>",
        "^@/tabler-icons(/.*)?$",
        "^@/constants(/.*)?$",
        "^@/enums(/.*)?$",
        "^@/interfaces(/.*)?$",
        "^@/types(/.*)?$",
        "^@/config(/.*)?$",
        "^@/lib(/.*)?$",
        "^@/utils(/.*)?$",
        "^@/commons(/.*)?$",
        "^@/modules(/.*)?$",
        "^@/database(/.*)?$",
        "^@/hooks(/.*)?$",
        "^@/contexts(/.*)?$",
        "^@/services(/.*)?$",
        "^@/features(/.*)?$",
        "^@/components(/.*)?$",
        "^@/app(/.*)?$",
        "^[./]"
    ],
    "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
    "overrides": [
        {
            "files": ["apps/mobile/**/*", "packages/design-system/mobile/**/*"],
            "options": {
                "importOrder": [
                    "^\\..*\\.css$",
                    "^node:(.*)$",
                    "^react$",
                    "^react-native$",
                    "^expo$",
                    "^expo-(.*)$",
                    "^@react-native(.*)$",
                    "^@expo(.*)$",
                    "<THIRD_PARTY_MODULES>",
                    "^@repo/(.*)$",
                    "^@/contexts(/.*)?$",
                    "^@/core(/.*)?$",
                    "^@/features(/.*)?$",
                    "^@/lib(/.*)?$",
                    "^@/providers(/.*)?$",
                    "^@/shared(/.*)?$",
                    "^@/(.*)$",
                    "^\\.(.*)$"
                ]
            }
        }
    ]
}
