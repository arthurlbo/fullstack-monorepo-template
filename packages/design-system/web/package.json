{
    "name": "@repo/design-system-web",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "tsup",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prettier:fix": "prettier --write .",
        "format": "pnpm lint:fix && pnpm prettier:fix",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./components": {
            "types": "./dist/components/index.d.ts",
            "import": "./dist/components/index.mjs",
            "require": "./dist/components/index.cjs"
        },
        "./utils": {
            "types": "./dist/shared/utils/index.d.ts",
            "import": "./dist/shared/utils/index.mjs",
            "require": "./dist/shared/utils/index.cjs"
        },
        "./globals.css": "./dist/globals.css",
        "./postcss.config": "./dist/postcss.config.mjs"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.2.4",
        "@tabler/icons-react": "^3.44.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@repo/eslint": "workspace:*",
        "@repo/tsup": "workspace:*",
        "@repo/typescript": "workspace:*",
        "@tailwindcss/postcss": "^4.3.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "^10.2.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwindcss": "^4.3.0",
        "tsup": "^8.5.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3"
    }
}
