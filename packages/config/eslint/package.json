{
    "name": "@repo/eslint",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup"
    },
    "exports": {
        "./base": {
            "types": "./dist/base.d.ts",
            "import": "./dist/base.mjs",
            "require": "./dist/base.cjs"
        },
        "./next": {
            "types": "./dist/next.d.ts",
            "import": "./dist/next.mjs",
            "require": "./dist/next.cjs"
        },
        "./nest": {
            "types": "./dist/nest.d.ts",
            "import": "./dist/nest.mjs",
            "require": "./dist/nest.cjs"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.mjs",
            "require": "./dist/react.cjs"
        },
        "./expo": {
            "types": "./dist/expo.d.ts",
            "import": "./dist/expo.mjs",
            "require": "./dist/expo.cjs"
        }
    },
    "peerDependencies": {
        "eslint": "^9.37.0"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@next/eslint-plugin-next": "^16.2.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-turbo": "^2.9.14",
        "globals": "^17.5.0",
        "typescript-eslint": "^8.62.1"
    },
    "devDependencies": {
        "@repo/tsup": "workspace:*",
        "@repo/typescript": "workspace:*",
        "tsup": "^8.5.1"
    }
}
