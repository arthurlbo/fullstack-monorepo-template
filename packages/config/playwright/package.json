{
    "name": "@repo/playwright",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "files": ["dist"],
    "scripts": {
        "build": "tsup",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "lint:fix:unsafe": "biome check --write --unsafe ."
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "peerDependencies": {
        "@playwright/test": "^1.56.0"
    },
    "devDependencies": {
        "@repo/tsup": "workspace:*",
        "@repo/typescript": "workspace:*",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    }
}
