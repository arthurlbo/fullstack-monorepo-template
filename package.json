{
    "name": "fullstack-monorepo-template",
    "description": "A modern Full-stack monorepo template to kickstart your web development.",
    "author": "Arthur Lobo",
    "private": true,
    "version": "0.0.1",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/arthurlbo/fullstack-monorepo-template.git"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "cross-env NODE_ENV=development turbo run dev",
        "start:staging": "cross-env NODE_ENV=staging turbo run start",
        "start:production": "cross-env NODE_ENV=production turbo run start",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "prettier:fix": "turbo run prettier:fix",
        "format": "turbo run format",
        "typecheck": "turbo run typecheck",
        "docker:dev": "docker compose -f docker-compose.development.yaml --env-file .env.development up -d",
        "docker:staging": "docker compose -f docker-compose.staging.yaml --env-file .env.staging up -d",
        "docker:production": "docker compose -f docker-compose.production.yaml --env-file .env.production up -d",
        "commit": "cz"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@repo/typescript": "workspace:*",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/node": "^24.7.2",
        "commitizen": "^4.3.1",
        "cross-env": "^10.1.0",
        "cz-conventional-changelog": "^3.3.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "turbo": "^2.5.8",
        "typescript": "5.9.2"
    },
    "packageManager": "pnpm@10.18.2",
    "engines": {
        "node": ">=20"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
