{
    "extends": "@repo/typescript/next.json",
    // Need to add these configs directly here because Next.js.
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.css",
        "**/*.tsx",
        "next-env.d.ts",
        "next.config.js",
        ".next/types/**/*.ts",
        "tests/jest.config.tests/jest.setup.jstup.js"
    ],
    "exclude": ["node_modules"]
}
