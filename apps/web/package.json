{
    "name": "web",
    "version": "1.0.0",
    "description": "Next.js 16 web app — part of the fullstack monorepo template",
    "author": "Arthur Lobo",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack --port 3000",
        "build": "next build --turbopack",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prettier:fix": "prettier --write .",
        "format": "pnpm lint:fix && pnpm prettier:fix",
        "typecheck": "tsc --noEmit",
        "test:unit": "vitest run --passWithNoTests",
        "test:unit:coverage": "vitest run --coverage",
        "test:unit:watch": "vitest",
        "pretest:e2e": "playwright install chromium",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "pnpm test:unit && pnpm test:e2e"
    },
    "dependencies": {
        "@bprogress/next": "^3.2.12",
        "@repo/design-system": "workspace:*",
        "@tabler/icons-react": "^3.41.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "next": "^16.2.4",
        "next-themes": "^0.4.6",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tailwind-merge": "^3.5.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@repo/eslint": "workspace:*",
        "@repo/playwright": "workspace:*",
        "@repo/typescript": "workspace:*",
        "@repo/vitest": "workspace:*",
        "@tailwindcss/postcss": "^4.2.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.6.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^10.2.1",
        "jsdom": "^26.1.0",
        "tailwindcss": "^4.2.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "6.0.3",
        "vitest": "^3.2.4"
    }
}
