{
    "name": "api",
    "version": "1.0.0",
    "description": "NestJS 11 API — part of the fullstack monorepo template",
    "author": "Arthur Lobo",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "nest start --watch",
        "dev:debug": "nest start --debug --watch",
        "build": "nest build",
        "start": "node dist/main",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prettier:fix": "prettier --write .",
        "format": "pnpm lint:fix && pnpm prettier:fix",
        "typecheck": "tsc --noEmit",
        "test:unit": "vitest run --passWithNoTests",
        "test:unit:coverage": "vitest run --coverage",
        "test:unit:watch": "vitest",
        "test:e2e": "vitest run --config vitest-e2e.config.ts",
        "test:all": "pnpm test:unit && pnpm test:e2e",
        "typeorm:tsx": "tsx ./node_modules/typeorm/cli.js",
        "migrate:generate": "pnpm typeorm:tsx migration:generate -d ./src/infra/database/data-source.ts",
        "migrate:up": "pnpm typeorm:tsx migration:run -d ./src/infra/database/data-source.ts",
        "migrate:down": "pnpm typeorm:tsx migration:revert -d ./src/infra/database/data-source.ts",
        "clear:db": "pnpm typeorm:tsx schema:drop -d ./src/infra/database/data-source.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.21",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.21",
        "@nestjs/platform-express": "^11.1.21",
        "@nestjs/swagger": "^11.4.3",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/typeorm": "^11.0.1",
        "@repo/contracts": "workspace:*",
        "@repo/env": "workspace:*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "compression": "^1.8.0",
        "helmet": "^8.0.0",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.29",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.21",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.21",
        "@repo/eslint": "workspace:*",
        "@repo/typescript": "workspace:*",
        "@repo/vitest": "workspace:*",
        "@swc/core": "^1.15.40",
        "@types/compression": "^1.7.5",
        "@types/express": "^5.0.6",
        "@types/node": "^25.8.0",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.6",
        "eslint": "^10.2.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.22.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.6"
    }
}
