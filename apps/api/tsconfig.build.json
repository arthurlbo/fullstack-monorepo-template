{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
    },
    "exclude": ["node_modules", "test", "dist", "**/*.spec.ts", "**/*.test.ts", "jest.config.ts", "jest.setup.ts"]
}
