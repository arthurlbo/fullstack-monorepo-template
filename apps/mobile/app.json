{
    "expo": {
        "name": "Mobile",
        "slug": "mobile",
        "scheme": "mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "dark",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.template.mobile"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#0F131F"
            },
            "package": "com.template.mobile"
        },
        "web": {
            "bundler": "metro"
        },
        "plugins": [
            [
                "expo-router",
                {
                    "root": "./src/app"
                }
            ],
            "expo-font",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#0F131F"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
