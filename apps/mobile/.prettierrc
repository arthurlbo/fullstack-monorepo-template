{
    "plugins": ["prettier-plugin-tailwindcss", "@trivago/prettier-plugin-sort-imports"],
    "bracketSameLine": false,
    "printWidth": 120,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "importOrder": [
        "^\\..*\\.css$",
        "^node:(.*)$",
        "^react$",
        "^react-native$",
        "^expo$",
        "^expo-(.*)$",
        "^@react-native(.*)$",
        "^@expo(.*)$",
        "<THIRD_PARTY_MODULES>",
        "^@repo/(.*)$",
        "^@/contexts(/.*)?$",
        "^@/core(/.*)?$",
        "^@/features(/.*)?$",
        "^@/lib(/.*)?$",
        "^@/providers(/.*)?$",
        "^@/shared(/.*)?$",
        "^@/(.*)$",
        "^\\.(.*)$"
    ]
}
