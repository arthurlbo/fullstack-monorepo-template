{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalEnv": [
        "NODE_ENV",
        "NEXT_PUBLIC_API_URL"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "start": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["build"]
        },
        "lint": {},
        "lint:fix": {},
        "lint:fix:unsafe": {},
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test:unit": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["coverage/**"],
            "cache": true
        },
        "test:unit:coverage": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["coverage/**"],
            "cache": true
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test:all": {
            "dependsOn": ["test:unit", "test:e2e"],
            "cache": false
        }
    }
}
