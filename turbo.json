{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalEnv": ["API_PORT"],
    "tasks": {
        "build": {
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint:fix": {
            "dependsOn": ["^lint:fix"]
        },
        "prettier:fix": {
            "dependsOn": ["^prettier:fix"]
        },
        "format": {
            "dependsOn": ["^format"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "test:unit": {
            "cache": false,
            "persistent": true
        },
        "test:unit:coverage": {
            "outputs": ["coverage/**"]
        },
        "test:e2e": {
            "cache": false,
            "persistent": true
        },
        "test:all": {
            "cache": false,
            "persistent": true
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
